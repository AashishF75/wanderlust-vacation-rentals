<% layout("/layouts/boilerplate") %>

    <style>
        body {
            margin: 0;
            padding: 0;
        }

        /* MAIN TOP BAR */
        .top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.5rem 1.5rem;
            border-bottom: 1px solid #ddd;
        }

        /* FILTERS INLINE */
        #filters {
            display: flex;
            align-items: center;
            gap: 1.8rem;
            overflow-x: auto;
        }

        .filter {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            font-size: 0.85rem;
            white-space: nowrap;
            opacity: 0.8;
        }

        .filter:hover {
            opacity: 1;
        }

        /* TOGGLE BOX */
        .toggle-box {
            display: flex;
            align-items: center;
            gap: 10px;
            border: 1px solid #ccc;
            border-radius: 20px;
            margin-bottom: auto;
            padding: 7px 12px;
            background-color: #f8f9fa;
            white-space: nowrap;
        }

        .listing-card img {
            height: 16rem;
            /* object-fit: cover; */
            border-radius: 15px;
        }

        .link_img {
            text-decoration: none;
            color: inherit;
        }

        .tax-info {
            display: none;
            color: green;
            font-size: 0.8rem;
        }

        .container {
            margin-top: 0.5rem;
        }
    </style>

    <!-- TOP BAR (FILTERS + TOGGLE SAME ROW) -->
    <div class="top-bar">

        <div id="filters">
            <a href="/listings?category=Trending" class="filter text-decoration-none text-dark"><i class="fa-solid fa-fire"></i>
                <p>Trending</p>
            </a>
            <a href="/listings?category=Room" class="filter text-decoration-none text-dark"><i class="fa-solid fa-bed"></i>
                <p>Room</p>
            </a>
            <a href="/listings?category=City" class="filter text-decoration-none text-dark"><i class="fa-solid fa-city"></i>
                <p>City</p>
            </a>
            <a href="/listings?category=Mountain" class="filter text-decoration-none text-dark"><i class="fa-solid fa-mountain"></i>
                <p>Mountain</p>
            </a>
            <a href="/listings?category=Cottage" class="filter text-decoration-none text-dark"><i class="fa-solid fa-house"></i>
                <p>Cottage</p>
            </a>
            <a href="/listings?category=Pool" class="filter text-decoration-none text-dark"><i class="fa-solid fa-person-swimming"></i>
                <p>Pool</p>
            </a>
            <a href="/listings?category=Farms" class="filter text-decoration-none text-dark"><i class="fa-solid fa-tractor"></i>
                <p>Farms</p>
            </a>
            <a href="/listings?category=Camping" class="filter text-decoration-none text-dark"><i class="fa-solid fa-tent"></i>
                <p>Camping</p>
            </a>
            <a href="/listings?category=Arctic" class="filter text-decoration-none text-dark"><i class="fa-solid fa-snowflake"></i>
                <p>Arctic</p>
            </a>
            <a href="/listings?category=Doms" class="filter text-decoration-none text-dark"><i class="fa-solid fa-landmark-dome"></i>
                <p>Doms</p>
            </a>
            <a href="/listings?category=Sailboats" class="filter text-decoration-none text-dark"><i class="fa-solid fa-sailboat"></i>
                <p>Sailboats</p>
            </a>
            <a href="/listings" class="filter text-decoration-none text-dark"><i class="fa-solid fa-rotate-left"></i>
                <p>All</p>
            </a>
        </div>

        <div class="toggle-box">
            <input type="checkbox" id="flexSwitchCheckDefault">
            <label for="flexSwitchCheckDefault">Display total after taxes</label>
        </div>

    </div>

    <!-- LISTINGS -->
    <div class="container">
        <div class="row row-cols-1 row-cols-md-3 g-3 my-3">
            <% if (alllistings && alllistings.length > 0) { %>
                <% for(let list of alllistings) { %>

                <div class="col">
                    <a href="/listings/<%= list._id %>" class="link_img">
                        <div class="card listing-card h-100 shadow-sm border-0">
                            <img src="<%= list.image.url %>" class="card-img-top" alt="image">

                            <div class="card-body p-2">
                                <h6 class="card-title">
                                    <%= list.title %>
                                </h6>
                                <p class="card-text mb-1">
                                    ₹ <%= list.price.toLocaleString("en-IN") %> / night
                                        <span class="tax-info"> +18% GST</span>
                                </p>
                            </div>
                        </div>
                    </a>
                </div>

                <% } %>
            <% } else { %>
                <div class="col-12 text-center py-5">
                    <h4 class="text-muted">No listings available.</h4>
                    <a href="/listings" class="btn btn-outline-danger mt-3">Explore All Listings</a>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        const taxToggle = document.getElementById('flexSwitchCheckDefault');

        taxToggle.addEventListener('change', () => {
            const taxInfoElements = document.querySelectorAll('.tax-info');

            taxInfoElements.forEach(el => {
                el.style.display = taxToggle.checked ? 'inline' : 'none';
            });
        });
    </script>