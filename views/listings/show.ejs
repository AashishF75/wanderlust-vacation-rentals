<% layout("/layouts/boilerplate") %>
    <script>
        const mapToken = `<%= MAP_TOKEN %>`;
        // Use JSON.parse and backticks to force it into a real array
        const coordinates = JSON.parse(`<%- JSON.stringify(listings.geometry.coordinates) %>`);
    </script>







    <div class="container mt-4">

        <!-- ================= CARD ROW ================= -->
        <div class="row justify-content-center">
            <div class="col-md-6 d-flex justify-content-center">

                <div class="card listing-card" style="width: 18rem;">
                    <img src="<%= listings.image.url %>" class="card-img-top" alt="img">

                    <div class="casrd-body">
                        <h5 class="card-title">
                            <%= listings.title %>
                        </h5>
                    </div>

                    <div class="card-text px-3">

                        <p> owner: <i>
                                <%= listings.owner.username %>
                            </i></p>
                    </div>
                    <div class="card-text px-3">

                        <%= listings.description %>
                    </div>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <%= listings.location %>
                        </li>
                        <li class="list-group-item">
                            ₹<%= listings.price.toLocaleString("en-IN") %>
                        </li>
                        <li class="list-group-item">
                            <%= listings.country %>
                        </li>
                    </ul>
                    <% if(curruser && listings.owner._id.equals(curruser._id)) { %>
                        <a href="/listings/<%= listings._id %>/edit" class="btn btn-dark m-2">
                            Edit
                        </a>

                        <form method="POST" action="/listings/<%= listings._id %>?_method=DELETE" class="m-2">
                            <button class="btn btn-danger w-100">Delete</button>
                        </form>
                        <%}%>

                </div>

            </div>
        </div>

        <!-- ================= REVIEW ROW ================= -->
        <div class="row mt-5">
            <div class="col-md-8 offset-md-2">
                <% if(curruser) { %>
                    <h4>Leave your Review</h4>


                    <form method="POST" action="/listings/<%= listings._id %>/reviews" novalidate
                        class="needs-validation">
                        <div class="mb-3 mt-3">
                            <fieldset class="starability-slot">

                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1"
                                    checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        </div>
                        <div class="mb-3 mt-3">
                            <label for="comment" class="form-label">Review</label>
                            <textarea name="review[comment]" id="comment" rows="3" class="form-control"
                                placeholder="Write your review here..." required></textarea>
                            <div class="invalid-feedback">Please submit your comment</div>
                        </div>



                        <button class="btn btn-primary">Submit Review</button>
                    </form>
                    <%}%>



                        <div class="row">

                            <% if(listings.reviews.length> 0) { %>
                                <h4 class="mb-3">All Reviews</h4>

                                <% for(let rev of listings.reviews) { %>

                                    <div class="col-md-6 mb-3">
                                        <div class="card shadow-sm h-100">

                                            <div class="card-body">
                                                <h4 class="card-text">
                                                    <%= rev.author ? rev.author.username : "Unknown User" %>
                                                </h4>
                                                <p class="starability-result card-text" data-rating="<%= rev.rating %>">
                                                    <%= rev.rating %>
                                                </p>



                                                <p class="card-text">
                                                    <%= rev.comment %>
                                                </p>
                                                <form class="mb-3" method="POST"
                                                    action="/listings/<%=listings._id %>/reviews/<%= rev._id %>?_method=DELETE">
                                                    <button class="btn btn-danger btn-sm">Delete</button>
                                                </form>
                                            </div>

                                        </div>

                                    </div>

                                    <% } %>

                                        <% } else { %>

                                            <p class="text-muted">No reviews yet 😢</p>

                                            <% } %>

                        </div>




            </div>

            <div class="col-md-7 offset-md-2 mt-5">
                <h1>Where will be</h1>
                <div id="map" style="height: 300px;">

                </div>

            </div>


        </div>

        <script src="/js/map.js"></script>