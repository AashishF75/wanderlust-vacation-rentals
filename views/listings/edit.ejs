<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row">
            <div class="col-8 offset-2">
                <h2>Edit your details</h2>
                <form action="/listings/<%= listings._id %>?_method=PUT" method="POST" class="needs-validation"
                    novalidate enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="title">Title:</label>
                        <input type="text" id="title" name="listing[title]" value="<%= listings.title %>"
                            class="form-control" required>
                    </div>
                    <div class="row">
                        <div class="mb-3 col-md-4">
                            <label for="price">Price:</label>
                            <input type="number" id="price" name="listing[price]" value="<%= listings.price %>" required
                                class="form-control">
                        </div>
                        <div class="mb-3 col-md-8">
                            <label for="country">Country:</label>
                            <input type="text" id="country" name="listing[country]" value="<%= listings.country %>"
                                required class="form-control">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="description">Description:</label>
                        <textarea id="description" name="listing[description]" required
                            class="form-control"><%=listings.description%></textarea>
                    </div>
                    <div class="row">
                        <div class="mb-3 col-md-6">
                            <label for="location">Location:</label>
                            <input type="text" id="location" name="listing[location]" value="<%=listings.location%>"
                                required class="form-control">
                        </div>
                        <div class="mb-3 col-md-6">
                            <label for="category">Category:</label>
                            <select name="listing[category]" id="category" class="form-select">
                                <option value="Trending" <%= listings.category === 'Trending' ? 'selected' : '' %>>Trending</option>
                                <option value="Room" <%= listings.category === 'Room' ? 'selected' : '' %>>Room</option>
                                <option value="City" <%= listings.category === 'City' ? 'selected' : '' %>>City</option>
                                <option value="Mountain" <%= listings.category === 'Mountain' ? 'selected' : '' %>>Mountain</option>
                                <option value="Cottage" <%= listings.category === 'Cottage' ? 'selected' : '' %>>Cottage</option>
                                <option value="Pool" <%= listings.category === 'Pool' ? 'selected' : '' %>>Pool</option>
                                <option value="Farms" <%= listings.category === 'Farms' ? 'selected' : '' %>>Farms</option>
                                <option value="Camping" <%= listings.category === 'Camping' ? 'selected' : '' %>>Camping</option>
                                <option value="Arctic" <%= listings.category === 'Arctic' ? 'selected' : '' %>>Arctic</option>
                                <option value="Doms" <%= listings.category === 'Doms' ? 'selected' : '' %>>Doms</option>
                                <option value="Sailboats" <%= listings.category === 'Sailboats' ? 'selected' : '' %>>Sailboats</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        Original Listing Image<br>
                        <img src="<%= originalImageurl %>" alt="Original Image" class="img-thumbnail"
                            style="max-width: 200px;">
                    </div>
                    <div class="mb-3">
                        <label for="image">NEW upload image:</label>
                        <input type="file" id="image" name="listing[image]" class="form-control">
                    </div>


                    <button class="btn btn-dark add-btn">Save Changes</button>
                </form>
            </div>
        </div>
        <script src="/js/script.js"></script>
    </body>