# ==============================================================================
# WANDERLUST APPLICATION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' in the project root:
#   PowerShell: Copy-Item .env.example .env
#
# Fill in your own credentials below. Never commit your actual .env file to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MANDATORY)
# ------------------------------------------------------------------------------
# For Local MongoDB (Already installed and running on Windows default port 27017):
ATLAS_URI=mongodb://127.0.0.1:27017/wunderlust
#
# For MongoDB Atlas (Cloud Database - Alternative):
# ATLAS_URI=mongodb+srv://<username>:<password>@<cluster-url>/wunderlust?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. MAPBOX CONFIGURATION (MANDATORY FOR SERVER STARTUP & MAPS)
# ------------------------------------------------------------------------------
# Public Access Token from Mapbox (starts with 'pk.ey...').
# Obtain free from: https://account.mapbox.com/access-tokens/
# NOTE: The server checks this token at startup in controllers/listing.js.
# Without a valid token format, the server will not start.
MAP_TOKEN=your_mapbox_public_token_here

# ------------------------------------------------------------------------------
# 3. CLOUDINARY CONFIGURATION (MANDATORY FOR LISTING IMAGE UPLOADS)
# ------------------------------------------------------------------------------
# Cloudinary account credentials for handling image uploads through multer-storage-cloudinary.
# Obtain free from Cloudinary Console Dashboard: https://console.cloudinary.com/
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 4. APPLICATION SERVER CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Port for the Node.js Express server (defaults to 8080 if not set)
PORT=8080

# Session secret key for express-session cookie encryption
SECRET=your_super_secret_session_key_here

